# Discord
DISCORD_TOKEN=
# Bio « À propos » du bot (400 car. max). Vide ou off = ne pas toucher.

# Serveur HTTP (Fly / Render / local)
PORT=3000
HOST=0.0.0.0

# Twitch — compte BOT pour IRC
TWITCH_ENABLED=true
TWITCH_USERNAME=
TWITCH_OAUTH_TOKEN=
TWITCH_CHANNEL=
TWITCH_PREFIX=!
# Commandes MiyuBot à ignorer si un autre bot (WizeBot) les gère déjà
# Exemple (WizeBot) : ping,help,uptime,title,game
# Ne pas y mettre so, discord, socials si MiyuBot doit les garder
TWITCH_DISABLED_COMMANDS=

# Helix (app Twitch) — !uptime !title !game !so
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Alerte pubs : token du STREAMER, scope channel:read:ads
TWITCH_ADS_TOKEN=
TWITCH_AD_WARNING=true
TWITCH_AD_WARNING_SECONDS=30
TWITCH_ADS_POLL_MS=8000

# Clips !clip : token du STREAMER (ou éditeur), scope clips:edit
TWITCH_CLIPS_TOKEN=

# Annonce Ko-fi toutes les 45 min en live (TWITCH_DONATE_ANNOUNCE=false pour couper)
TWITCH_DONATE_ANNOUNCE=true
TWITCH_DONATE_INTERVAL_MS=2700000

# Optionnel
TWITCH_DISCORD_LIVE_CHANNEL_ID=
TWITCH_DISCORD_INVITE=
TWITCH_SOCIALS_URL=
TWITCH_TWITTER=
TWITCH_YOUTUBE=
TWITCH_TIKTOK=

# Performance / automod (défauts OK)
TWITCH_COMMAND_COOLDOWN_MS=2500
TWITCH_USER_COOLDOWN_MS=4000
TWITCH_CHAT_DELAY_MS=1600
TWITCH_LIVE_POLL_MS=45000
TWITCH_AUTOMOD=true
TWITCH_SPAM_THRESHOLD=6
TWITCH_SPAM_WINDOW_MS=8000
TWITCH_REPEAT_THRESHOLD=3
TWITCH_CAPS_MIN_LENGTH=12
TWITCH_CAPS_RATIO=0.8
TWITCH_LINK_TIMEOUT=1
TWITCH_SPAM_TIMEOUT=30
TWITCH_CAPS_TIMEOUT=5
