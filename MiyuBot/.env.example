# Discord
DISCORD_TOKEN=your_discord_bot_token

# Serveur HTTP (obligatoire sur Railway / Render / Fly)
PORT=3000
HOST=0.0.0.0

# Twitch
TWITCH_ENABLED=true
TWITCH_USERNAME=your_twitch_bot_username
TWITCH_OAUTH_TOKEN=oauth:your_twitch_oauth_token
TWITCH_CHANNEL=your_twitch_channel_name
TWITCH_PREFIX=!

# Helix (uptime, titre, jeu, shoutout enrichi, annonce live)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Alerte pubs auto (token du STREAMER, scope channel:read:ads)
TWITCH_ADS_TOKEN=
TWITCH_AD_WARNING=true
TWITCH_AD_WARNING_SECONDS=30
TWITCH_ADS_POLL_MS=8000

# Annonce live Discord (ID du salon)
TWITCH_DISCORD_LIVE_CHANNEL_ID=

# Réseaux
TWITCH_DISCORD_INVITE=
TWITCH_TWITTER=
TWITCH_YOUTUBE=
TWITCH_TIKTOK=

# Performance / automod
TWITCH_COMMAND_COOLDOWN_MS=2500
TWITCH_USER_COOLDOWN_MS=4000
TWITCH_CHAT_DELAY_MS=1600
TWITCH_LIVE_POLL_MS=45000
TWITCH_AUTOMOD=true
TWITCH_SPAM_THRESHOLD=6
TWITCH_SPAM_WINDOW_MS=8000
TWITCH_REPEAT_THRESHOLD=3
TWITCH_CAPS_MIN_LENGTH=12
TWITCH_CAPS_RATIO=0.8
TWITCH_LINK_TIMEOUT=1
TWITCH_SPAM_TIMEOUT=30
TWITCH_CAPS_TIMEOUT=5
